---
import data from '../data/timeline.json';
import { validateTimeline } from '../data/timeline.schema';
import TimelineEntry from './TimelineEntry.astro';

const entries = validateTimeline(data);
---

<section id="history" class="mx-auto max-w-6xl px-6 py-24 md:px-10 lg:pr-28">
  <div class="max-w-2xl">
    <h2 class="font-display text-4xl font-bold leading-tight text-fg md:text-5xl">
      A decade of battles
    </h2>
    <p class="mt-4 leading-relaxed text-fg-muted">
      From an internal contest for APU students to an international competition. Each edition
      raised the bar for the next.
    </p>
  </div>

  <ol
    class="relative mt-16 grid gap-12 before:absolute before:bottom-0 before:left-4 before:top-0 before:w-px before:bg-line md:gap-16 md:before:left-1/2 md:before:-translate-x-1/2"
  >
    {entries.map((entry, index) => <TimelineEntry entry={entry} index={index} />)}
  </ol>
</section>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
