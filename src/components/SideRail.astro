---
const items = [
  { href: '#home', label: 'Home' },
  { href: '#host', label: 'Host' },
  { href: '#history', label: 'History' },
];
---

<nav
  data-rail
  aria-label="Sections"
  class="fixed right-3 top-1/2 z-50 -translate-y-1/2 md:right-6"
>
  <ol class="flex flex-col gap-5">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class="group flex items-center justify-end gap-3 py-1 text-fg-muted transition-colors hover:text-fg data-active:text-cyan"
          >
            <span class="hidden font-display text-sm font-medium md:inline">{item.label}</span>
            <span
              class="block h-px w-4 bg-current transition-all group-data-active:h-0.5 group-data-active:w-8"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  import { initRail } from '../scripts/rail';
  initRail();
</script>
